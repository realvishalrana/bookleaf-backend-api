# Docker (docker compose up -d): root / password
DATABASE_URL="mysql://root:password@localhost:3306/bookleaf"
# Local MySQL without password: mysql://root@localhost:3306/bookleaf
# Local MySQL with password: mysql://root:YOUR_PASSWORD@localhost:3306/bookleaf
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# --- Option A: Google Gemini (AI Studio) — key starts with AIza...
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_CLASSIFY_MODEL="gemini-2.0-flash"
OPENAI_DRAFT_MODEL="gemini-2.0-flash"

# --- Option B: Antigravity Manager proxy (key like sk-antigravity)
# OPENAI_BASE_URL="http://127.0.0.1:8045/v1"
# OPENAI_CLASSIFY_MODEL="gemini-2.0-flash"
# OPENAI_DRAFT_MODEL="gemini-2.0-flash"

# --- Option C: OpenAI directly — leave OPENAI_BASE_URL empty
# OPENAI_CLASSIFY_MODEL="gpt-4o-mini"
# OPENAI_DRAFT_MODEL="gpt-4o"
CORS_ORIGIN_AUTHOR="http://localhost:3000"
CORS_ORIGIN_ADMIN="http://localhost:3001"
PORT=4000
NODE_ENV=development
